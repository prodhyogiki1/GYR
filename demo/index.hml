    <section class="hero-slider">
        <div class="slider-container">
            <div class="slide active" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('images/bg.jpg');"></div>
        </div>
        <div class="hero-overlay-content">
            <div class="container">
                <h1 class="reveal-up"><span style="color:#FFF;">Find Your Perfect</span> <span class="gradient-text">Adventure</span></h1>
                <div class="search-container-round">
                    <div class="search-input-group">
                        <input type="text" placeholder="Search bikes (e.g. Enfield, Activa)..." class="round-input">
                        <button class="btn-search-round">Search Bikes</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="about-section">
        <div class="container flex-row">
            <div class="about-img">
                <img src="https://images.unsplash.com/photo-1515777315835-281b94c9589f?auto=format&fit=crop&q=80&w=800" alt="About Get Your Ride">
                <div class="experience-badge">10+ Years Experience</div>
            </div>
            <div class="about-content">
                <span class="badge">About Us</span>
                <h2>Your Trusted Partner for <br><span class="gradient-text">Road Explorations</span></h2>
                <p>At Get Your Ride, we believe every journey should be an adventure. Based in Jodhpur, we provide a premium fleet of well-maintained bikes that combine performance with safety.</p>
                <ul class="about-list">
                    <li>✓ 24/7 Roadside Assistance</li>
                    <li>✓ Sanitized Helmets Provided</li>
                    <li>✓ Flexible Rental Plans</li>
                </ul>
                <button class="btn-secondary-outline">Learn More</button>
            </div>
        </div>
    </section>

