<!--- informative-->
<section class="features-section">
    <div class="container">
        <div class="section-header">
            <span class="badge">WHY CHOOSE US</span>
            <h2>We Provide Best Service <span>For You</span></h2>
            <div class="header-line"></div>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="icon-box">
                    <img src="https://cdn-icons-png.flaticon.com/512/3710/3710257.png" alt="Best Price">
                </div>
                <h3>Best Price Guarantee</h3>
                <p>We offer the most competitive rental rates in the city with no hidden charges or extra fees.</p>
            </div>

            <div class="feature-card">
                <div class="icon-box">
                    <img src="https://cdn-icons-png.flaticon.com/512/3144/3144467.png" alt="Sanitized Bikes">
                </div>
                <h3>Fully Sanitized</h3>
                <p>Your safety is our priority. Every vehicle is deep cleaned and sanitized after every single ride.</p>
            </div>

            <div class="feature-card">
                <div class="icon-box">
                    <img src="https://cdn-icons-png.flaticon.com/512/2830/2830305.png" alt="Free Helmet">
                </div>
                <h3>Free Helmet & Docs</h3>
                <p>We provide complimentary ISI-marked helmets and all valid vehicle documents for a worry-free ride.</p>
            </div>

            <div class="feature-card">
                <div class="icon-box">
                    <img src="https://cdn-icons-png.flaticon.com/512/912/912316.png" alt="24/7 Support">
                </div>
                <h3>24/7 Roadside Support</h3>
                <p>Experience peace of mind with our round-the-clock emergency assistance and mechanical support.</p>
            </div>
        </div>
    </div>
</section>


